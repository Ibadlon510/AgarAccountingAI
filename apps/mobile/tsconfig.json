{
  "extends": "../../tsconfig.base.json",
  "include": [
    "app/**/*",
    "src/**/*",
    "*.d.ts",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-native",
    "lib": [
      "esnext",
      "dom"
    ],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": [
      "react",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
