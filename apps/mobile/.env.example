# Clerk's development-instance publishable key (pk_test_...). Expo only
# exposes env vars prefixed EXPO_PUBLIC_ to the client bundle.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL of the API server, no trailing slash and no /api suffix
# (e.g. http://192.168.1.20:5000 for a local dev server reachable from a
# physical device on the same network — "localhost" will not work from a
# device or simulator the way it does in a browser).
EXPO_PUBLIC_API_BASE_URL=
